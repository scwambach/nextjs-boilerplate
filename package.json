    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "29.5.12",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "autoprefixer": "^10.5.2",
    "axe-core": "^4.12.1",

    "next": "^16.2.10",
    "next-auth": "^4.24.14",
    "next-sanity": "^13.1.1",
    "nodemailer": "^9.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-paginate": "^8.3.0",
    "react-player": "^3.4.0",
    "react-select": "^5.10.2",
    "sanity": "^6.3.0",
    "sanity-plugin-iframe-pane": "^5.0.23",
    "sanity-plugin-media": "^5.0.11",
    "styled-components": "^6.4.3",
